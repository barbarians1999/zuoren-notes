        Native.Reset(); input=Input(); input.ReceiptDirectoryIdentity="9:99999"; output=Invoke("--read-receipt",input,out code); Check(code==6 && Native.ProbeCalls==0 && Native.UserCalls==0, "wrong receipt directory identity is unresolved");
        Native.Reset(); input=Input(); Native.FailReceiptWrite=true; output=Invoke("",input,out code); Check(code==5 && FinalStatus(output)=="uncertain" && ReceiptBytes().Length==1 && ReceiptBytes()[0]==0 && File.Exists(Native.Real(input.Target)), "partial receipt write invalidates receipt and cannot report definite result");
