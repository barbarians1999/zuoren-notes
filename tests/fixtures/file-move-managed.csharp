        Native.Reset(); input=Input(); Native.FailStdoutFlush=true; output=Invoke("",input,out code); Check(code==5 && FinalStatus(output)=="uncertain", "postcommit stdout flush failure cannot downgrade to failed");
        Native.Reset(); input=Input(); Native.ProbeSupported=false; output=Invoke("",input,out code); Check(code==4 && Native.UserCalls==0, "same-process probe refusal is durably failed before user-root I/O"); AssertCleanReceiptResult(input,"failed");
        Native.Reset(); input=Input(); output=Invoke("",input,out code); input.RequestBinding=new string('c',64); var before=ReceiptBytes(); output=Invoke("--read-receipt",input,out code); Check(code==6 && Encoding.UTF8.GetString(before)==Encoding.UTF8.GetString(ReceiptBytes()), "wrong binding never echoes or edits a terminal receipt");
        Native.Reset(); input=Input(); output=Invoke("",input,out code); Native.ReceiptCloseFailure=true; output=Invoke("--read-receipt",input,out code); Check(code==6 && Native.ReceiptLocked(), "reader close failure cannot produce confirmed successful exit");
        Native.Reset(); input=Input(); Native.ReceiptCloseFailure=true; output=Invoke("",input,out code); Check(code==5 && Native.ReceiptLocked(), "writer close failure retains unknown outcome");
        Native.Reset(); input=Input(); input.ReceiptNonce="invalid"; output=Invoke("",input,out code); Check(code==5 && Native.ProbeCalls==0 && Native.UserCalls==0, "invalid receipt nonce cannot reach probe or user root");
    }
    private static void MoreCases() {
        int code; string output; MoveInput input;
        Native.Reset(); input=Input(true);
        var recoveryName="recovery\\"+Guid.NewGuid().ToString("D")+".json"; var recoverySource=FixturePath.Combine(FixturePath.GetDirectoryName(input.Source),".reader",recoveryName);
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Native.Real(recoverySource)));
        var rawText=FixtureJson.Encode(new Dictionary<string,object>{{"sourcePath",input.Source},{"content","PRIVATE X"}}); var raw=Encoding.UTF8.GetBytes(rawText); for(int n=0;n<raw.Length;n++) if(raw[n]==(byte)'X')raw[n]=255; File.WriteAllBytes(Native.Real(recoverySource),raw);
        var replacement=Encoding.UTF8.GetBytes(FixtureJson.Encode(new Dictionary<string,object>{{"sourcePath",input.Target},{"content","PRIVATE \uFFFD"}}));
        input.Records=new[]{new RecordInput{Source=recoverySource,Relative=recoveryName,RawHash=FileMoveWorker.Sha(raw),NextBase64=Convert.ToBase64String(replacement)}};
        output=Invoke("",input,out code); Check(code==4 && Native.BodyCalls==0 && Native.StageCalls==0, "invalid recovery UTF8 cannot be normalized into a moved draft");
        foreach (uint drive in new uint[]{4,0}) { Native.Reset(); input=Input(); Native.DriveKind=drive; output=Invoke("",input,out code); Check(code==4 && Native.UserCalls==0 && Native.BodyCalls==0, "nonfixed drive refused before user-root open kind="+drive); }
        Native.Reset(); input=Input(); using(var held=ReceiptLease.Acquire(input,true)) { held.Persist(new {status="failed",error="Move was refused before body commit."}); output=Invoke("--read-receipt",input,out code); Check(code==6 && Native.UserCalls==0, "a complete terminal snapshot remains unreadable while writer lease is held"); }
        Native.Reset(); input=Input(); using(var claim=ReceiptLease.Acquire(input,true)) {} var claimed=ReceiptBytes(); output=Invoke("",input,out code); Check(code==5 && Native.ProbeCalls==0 && Native.UserCalls==0 && Encoding.UTF8.GetString(claimed)==Encoding.UTF8.GetString(ReceiptBytes()), "crashed claimed receipt rejects late worker without overwrite"); output=Invoke("--read-receipt",input,out code); Check(code==6, "nonterminal claim never inferred to be a terminal failure");
        Native.Reset(); input=Input(); Native.FailClaimWrite=true; output=Invoke("",input,out code); Check(code==5 && Native.ProbeCalls==0 && Native.UserCalls==0 && ReceiptBytes().Length>0, "claim write fault cannot authorize any user-root I/O");
        Native.Reset(); input=Input(); Native.FailClaimFlush=true; output=Invoke("",input,out code); Check(code==5 && Native.ProbeCalls==0 && Native.UserCalls==0, "claim flush fault cannot authorize any user-root I/O");
        Native.Reset(); input=Input(); Native.Mode="stage-write-fail"; output=Invoke("",input,out code); Check(code==4 && Native.BodyCalls==0 && Native.PublishCalls==0 && !File.Exists(Native.Real(TargetRecord(input))), "unpublished staging failure cannot reach body or public metadata");
        Native.Reset(); input=Input(); input.Records=new[]{input.Records[0],input.Records[0]}; output=Invoke("",input,out code); Check(code==4 && Native.BodyCalls==0 && Native.StageCalls==0, "duplicate metadata target is refused before staging and commit");
        Native.Reset(); input=Input(); Native.Mode="publish-throw-after-commit"; output=Invoke("",input,out code); Check(code==5 && File.Exists(Native.Real(TargetRecord(input))) && File.Exists(Native.Real(input.Records[0].Source)) && File.Exists(Native.Real(input.Target)), "exceptional publish outcome preserves possibly public metadata and body");
        Native.Reset(); input=Input(); Native.Mode="user-close-fail"; output=Invoke("",input,out code); Check(code==5 && FinalStatus(output)=="uncertain" && File.Exists(Native.Real(input.Target)), "postcommit user-handle cleanup fault cannot become definite failed");
        Native.Reset(); input=Input(); File.WriteAllBytes(Native.Real(Native.ReceiptName),new byte[]{255}); output=Invoke("--read-receipt",input,out code); Check(code==6 && ReceiptBytes()[0]==255, "invalid UTF8 receipt stays read-only unresolved");
        Native.Reset(); input=Input(); File.WriteAllBytes(Native.Real(Native.ReceiptName),new byte[ReceiptProtocol.MaximumBytes+1]); output=Invoke("--read-receipt",input,out code); Check(code==6 && Native.UserCalls==0, "oversize receipt is bounded unresolved");
        Native.Reset(); input=Input(); Native.FailStdoutWrite=true; output=Invoke("",input,out code); Check(code==5 && output.IndexOf("failed",StringComparison.Ordinal)<0 && File.Exists(Native.Real(input.Target)), "stdout write fault cannot emit a false failed result");
        Native.Reset(); input=Input(); Native.FailReceiptFlush=true; Native.FailInvalidate=true; output=Invoke("",input,out code); Check(code==5 && FinalStatus(output)=="uncertain", "failed receipt invalidation never produces a definite worker result"); Native.FailReceiptFlush=Native.FailInvalidate=false; output=Invoke("--read-receipt",input,out code); Check(code==0 && File.Exists(Native.Real(input.Target)) && FileMoveWorker.Sha(File.ReadAllBytes(Native.Real(input.Target)))==input.ExpectedHash, "complete snapshot after flush error is only a fresh lease and current-state recheck");
    }
    public static void Main() {
        try { Console.WriteLine("managed-runtime: "+Environment.Version+"; pointerSize="+IntPtr.Size); CleanupCases(); TransactionCases(); ReceiptCases(); MoreCases(); Check(FileMoveWorker.ResultExitCode(new {status="receipt"})==0 && FileMoveWorker.ResultExitCode(new {status="unresolved"})==6 && FileMoveWorker.ResultExitCode(new {status="unsupported"})==3, "protocol2 receipt and unresolved exit-code contract"); Console.WriteLine("managed source-derived transaction regressions passed: "+count+"; no Windows APIs invoked"); }
        finally { Native.Finish(); }
    }
}
